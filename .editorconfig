# EditorConfig — editor-agnostic formatting rules, read natively by every major
# editor and IDE (https://editorconfig.org). Hygiene, not a stack choice: the same
# file works whatever the lab runtime (1.1) or the product stack (Phase 5) turn out to be.
root = true

[*]
charset = utf-8              # Arabic everywhere; UTF-8 (no BOM) is the one encoding every tool agrees on
end_of_line = lf             # one canonical line ending in history — see .gitattributes
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4              # PEP 8; matches lab/0.4-skill-graph/check_graph.py

[*.md]
trim_trailing_whitespace = false   # two trailing spaces are a hard line break in Markdown

[*.ps1]
end_of_line = crlf           # Windows-native scripts keep CRLF in the working tree
