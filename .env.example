# Nabta — environment variables for lab experiments ONLY.
#
# Copy to `.env` (ignored by git) and fill in. Nothing outside `lab/` reads these; the product's
# providers are configuration chosen in Phase 5, not these keys.
# Rules: never commit a real value; a provider that is free to you is still costed at list price;
# every experiment measures at least one alternative beside it.

# --- Candidate: Azure (employer access, agreed 2026-09-21) ---------------------------------
# Chat / generation models (Azure OpenAI or the AI Foundry catalog)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Azure Speech (F0 free tier: sequential requests only; check current limits before B1/B2)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Alternatives ----------------------------------------------------------------------------
# Added as each experiment names its comparison candidate (A2: a local model needs no key;
# B1/B2: an open engine needs no key). Hosted alternatives go here when chosen for a comparison.

# --- Lab settings ----------------------------------------------------------------------------
# Where experiments write raw outputs (ignored by git). Relative to the experiment folder.
NABTA_LAB_OUT=out
